# Copy this file to api/.env and fill in real values.
# Never commit api/.env (the root .gitignore ignores .env and .env.*).

# MongoDB connection string. The database name is the last path segment of
# the URL, so this one selects the local development database.
# Local development points at the locally installed MongoDB:
MONGO_URL=mongodb://127.0.0.1:27017/tradium_fastapi_dev
# A hosted/production connection string is supplied by the deployment
# environment. Never use it for local development and never commit it.

# Tests never read MONGO_URL. The fast suite runs in memory (mongomock); the
# optional integration suite reads TEST_MONGO_URL and refuses any database
# whose name does not end in "_test", for example:
#   TEST_MONGO_URL=mongodb://127.0.0.1:27017/tradium_fastapi_phase1_test

# Must be the same secret the Express app uses so existing login cookies
# stay valid during the migration.
JWT_SECRET=<long random string>

# Required for Nova (chat, page insights and the dashboard briefing). The key is
# read only on the server and is never sent to the browser. The assistant routes
# answer 503 when it is absent; the rest of the API keeps working.
GOOGLE_GENERATIVE_AI_API_KEY=<Gemini API key>

# Optional. Defaults to gemini-3.5-flash-lite, the model the Express app uses.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. "production" is the only value that changes anything: it makes the
# auth cookie `Secure`, exactly as the Express controller's NODE_ENV check does.
# NODE_ENV=production

# Optional. Comma-separated browser origins allowed to call the API with
# credentials. Defaults to the Vite dev server (localhost:5173-5177). Add the
# deployed frontend's origin here when it is not served by this API.
# CORS_ORIGINS=https://app.example.com

# Port for local uvicorn runs (optional, defaults to 8000)
PORT=8000

# Market-cache refresh (optional, defaults to OFF).
# Mirrors the Express cron: run marketSync once at startup, then every 5
# minutes, with the market-hours gate inside the job. Exactly ONE process may
# set this -- two services syncing the same collection would double the Yahoo
# requests and race on the same documents. Leave it unset while the Express
# deployment still owns the cache.
# MARKET_SYNC_ENABLED=true

# Trading jobs (optional, defaults to OFF).
# Mirrors the other two Express crons: syncPrices once at startup and every
# minute (it fills crossed OPEN orders, settles MIS exits and moves funds),
# plus recordDailySnapshot once a day at 18:00 IST. Exactly ONE process may
# set this -- two services would both try to fill the same orders and would
# write duplicate work against the same collections. Leave it unset while the
# Express deployment still owns its cron jobs.
# TRADING_JOBS_ENABLED=true
