# Copy this file to api/.env and fill in real values.
# Never commit api/.env (the root .gitignore ignores .env and .env.*).

# MongoDB connection string. The database name is the last path segment of
# the URL, so this one selects the local development database.
# Local development points at the locally installed MongoDB:
MONGO_URL=mongodb://127.0.0.1:27017/tradium_fastapi_dev
# A hosted/production connection string is supplied by the deployment
# environment. Never use it for local development and never commit it.

# Tests never read MONGO_URL. The fast suite runs in memory (mongomock); the
# optional integration suite reads TEST_MONGO_URL and refuses any database
# whose name does not end in "_test", for example:
#   TEST_MONGO_URL=mongodb://127.0.0.1:27017/tradium_fastapi_phase1_test

# Must be the same secret the Express app uses so existing login cookies
# stay valid during the migration.
JWT_SECRET=<long random string>

# Port for local uvicorn runs (optional, defaults to 8000)
PORT=8000
