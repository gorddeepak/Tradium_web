# Copy this file to api/.env and fill in real values.
# Never commit api/.env (the root .gitignore ignores .env and .env.*).

# The runtime is PostgreSQL-only: there is no MongoDB setting and startup opens
# no MongoDB connection.

# PostgreSQL. Authentication, the market cache, watchlists, the trading book,
# snapshots and Nova read PostgreSQL; it is the only database the FastAPI
# runtime reads or writes. DATABASE_URL is read by the PostgreSQL session
# module and the sync jobs.
# Use a local database such as tradium for development; never commit real
# credentials. The driver is psycopg 3.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/tradium
# Alembic uses the direct (non-pooled) connection; the app itself never reads it.
# Required for `alembic upgrade head`; there is no fallback to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/tradium

# The PostgreSQL integration tests run `alembic upgrade head` against this
# database, so its name must end in "_test". Tests are skipped when it is unset.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/tradium_test

# Signs the auth cookie. Use a long random string (at least 32 bytes); changing
# it logs every user out.
JWT_SECRET=<long random string>

# Required for Nova (chat, page insights and the dashboard briefing). The key is
# read only on the server and is never sent to the browser. The assistant routes
# answer 503 when it is absent; the rest of the API keeps working.
GOOGLE_GENERATIVE_AI_API_KEY=<Gemini API key>

# Optional. Defaults to gemini-3.5-flash-lite, the model the Express app uses.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. "production" is the only value that changes anything: it makes the
# auth cookie `Secure`, exactly as the Express controller's NODE_ENV check does.
# It also turns on serving the built frontend from dist/ (see SERVE_STATIC).
# NODE_ENV=production

# Optional. Serve the Vite build from dist/ with an SPA fallback. Defaults to
# the same rule as Express: on only when NODE_ENV=production. Set it explicitly
# to run the production-shaped server locally without the Secure cookie. Run
# `npm run build` first; the server logs a warning and serves API-only when
# dist/index.html is missing.
# SERVE_STATIC=true

# Optional. Comma-separated browser origins allowed to call the API with
# credentials. Defaults to the Vite dev server (localhost:5173-5177). Add the
# deployed frontend's origin here when it is not served by this API.
# CORS_ORIGINS=https://app.example.com

# Port for local uvicorn runs (optional, defaults to 8000)
PORT=8000

# Market-cache refresh (optional, defaults to OFF).
# Runs market_sync once at startup, then every 5 minutes, with the market-hours
# gate inside the job. The startup run seeds the 53-symbol NIFTY universe, so
# without this switch a fresh PostgreSQL database leaves the Markets page and
# instrument search empty.
# Set it to true for local development. Exactly ONE process may set this --
# two services syncing the same rows would double the Yahoo requests and race
# on the same instruments.
# MARKET_SYNC_ENABLED=true

# Trading jobs (optional, defaults to OFF).
# Runs syncPrices once at startup and every minute (it fills crossed OPEN
# orders, settles MIS exits and moves funds), plus recordDailySnapshot once a
# day at 18:00 IST. Exactly ONE process may set this -- two services would
# both try to fill the same orders and would write duplicate work against the
# same rows.
# TRADING_JOBS_ENABLED=true

# Live quote stream (optional, defaults to OFF).
# Opens ONE upstream Yahoo WebSocket per API process and pushes ticks to the
# browser through /api/quotes/stream. The provider endpoint is unofficial and
# not authorised for redistribution; read docs/migration/LIVE_MARKET_PRICES.md
# before enabling it. With the flag off, prices keep updating through the
# scheduled REST sync exactly as before.
# LIVE_QUOTES_ENABLED=true

# Optional, default 5 seconds (minimum 0.5). How often pending ticks are
# written to latest_quotes. Browser delivery happens immediately; PostgreSQL
# lags by at most this interval.
# LIVE_QUOTES_FLUSH_SECONDS=5

# Optional, default 60 seconds (minimum 5). A quote older than this is marked
# stale, and a tick older than this is rejected instead of applied.
# LIVE_QUOTES_STALE_SECONDS=60
